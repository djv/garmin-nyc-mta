<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <properties>
        <property id="proxyUrl" type="string">https://ubuntu-8gb-nbg1-1.tailca4726.ts.net</property>
        <property id="distanceUnit" type="number">0</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.proxyUrl" title="@Strings.ProxyTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.distanceUnit" title="@Strings.DistanceTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.DistanceWalk</listEntry>
                <listEntry value="1">@Strings.DistanceMeters</listEntry>
                <listEntry value="2">@Strings.DistanceFeet</listEntry>
                <listEntry value="3">@Strings.DistanceMiles</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
